initial
assume (= [$auto$async2sync.cc:107:execute$20] false)
assume (= [$auto$async2sync.cc:116:execute$24] true)
assume (= [gate_inst.count] #b10000000)
assume (= [gold_inst.count] #b00000000)

state 0
assume (= [clk] false)
assume (= [rst] true)

state 1
assume (= [clk] false)
assume (= [rst] false)

state 2
assume (= [clk] false)
assume (= [rst] false)
